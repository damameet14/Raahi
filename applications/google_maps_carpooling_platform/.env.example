# Google Maps Platform browser API key for local development.
# Copy this file to an untracked .env file in this application folder, then
# replace the placeholder below with a real key that has the required APIs
# enabled and browser referrer restrictions configured for local development.
#
# Required by:
# - Maps JavaScript API
# - Places API
# - Routes API
# - Browser geolocation map recentering workflow
#
# Vite maps this value to import.meta.env.VITE_GOOGLE_MAPS_API_KEY at build time.
# Never commit a real API key.
GOOGLE_MAPS_API_KEY=YOUR_API_KEY
