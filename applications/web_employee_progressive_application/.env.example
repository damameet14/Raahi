# Backend API base URL. Leave empty to use the Vite dev proxy (/api -> :8000).
VITE_API_URL=

# Google Maps JavaScript API browser key (Maps JS, Places, Routes enabled).
# Never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=YOUR_API_KEY

# Razorpay public key id (browser Checkout). The key secret stays server-side.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
