APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO

INTERNAL_API_KEY=replace_with_internal_key

ERP_DATABASE_TYPE=postgresql
ERP_DATABASE_URL=postgresql+psycopg2://raahi_user:raahi_secret@localhost:5432/raahi
ERP_DATABASE_READ_ONLY=true

CHATBOT_DATABASE_URL=sqlite:///./data/chatbot.sqlite3

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

FAISS_INDEX_PATH=./vector_db/faiss
RAG_SOURCE_DIRECTORY=./documents
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.45
CHUNK_SIZE=700
CHUNK_OVERLAP=100

AUTH_SESSION_EXPIRY_MINUTES=480
MAX_HISTORY_MESSAGES=20
MAX_AGENT_STEPS=8
