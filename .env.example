# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Supply a full DATABASE_URL to use an external PostgreSQL.
# If empty, the docker-compose postgres service is used.
DATABASE_URL=postgresql://raahi_user:raahi_secret@postgres_database:5432/raahi

# Docker-managed PostgreSQL defaults
POSTGRES_USER=raahi_user
POSTGRES_PASSWORD=raahi_secret
POSTGRES_DB=raahi

# ──────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ──────────────────────────────────────────────
# Application URLs
# ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000

# ──────────────────────────────────────────────
# External Services
# ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ──────────────────────────────────────────────
# Razorpay Payments (fare payments + wallet recharge)
# ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=Raahi
RAZORPAY_COMPANY_DESCRIPTION=Enterprise carpooling payment
RAZORPAY_THEME_COLOR=#249448

# ──────────────────────────────────────────────
# Email (SMTP) — best-effort; logs only when EMAIL_ENABLED=false
# ──────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Raahi
EMAIL_FROM_ADDRESS=no-reply@raahi.local

# ──────────────────────────────────────────────
# WhatsApp outbound bridge (Node whatsapp-web.js sidecar)
# best-effort; logs only when WHATSAPP_ENABLED=false
# ──────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_SERVICE_URL=http://localhost:8090
WHATSAPP_NOTIFICATION_API_KEY=replace_with_notification_key
