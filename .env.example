# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Supply a full DATABASE_URL to use an external PostgreSQL.
# If empty, the docker-compose postgres service is used.
DATABASE_URL=postgresql://raahi_user:raahi_secret@postgres_database:5432/raahi

# Docker-managed PostgreSQL defaults
POSTGRES_USER=raahi_user
POSTGRES_PASSWORD=raahi_secret
POSTGRES_DB=raahi

# ──────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ──────────────────────────────────────────────
# Application URLs
# ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
PAYMENT_PAGE_URL=http://localhost:5173/payments

# ──────────────────────────────────────────────
# External Services
# ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=GOOGLE_MAPS_API_KEY=AIzaSyDBs2tnvWIuaHcVWRAHIJcqz0J0gDoyIuQ

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=Carpooling Platform
RAZORPAY_COMPANY_DESCRIPTION=Employee completed ride payment
RAZORPAY_THEME_COLOR=#2fb86f
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_key_id

# Internal Nodemailer Bridge
EMAIL_NOTIFICATION_SERVICE_URL=http://localhost:8010
INTERNAL_EMAIL_SERVICE_TOKEN=replace_with_internal_service_token
EMAIL_SERVICE_PORT=8010

# Nodemailer SMTP
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASSWORD=replace_with_email_app_password
# For Gmail, SMTP_PASSWORD should normally be a Google App Password,
# not the normal Gmail account password.
EMAIL_FROM_NAME=Carpooling Platform
EMAIL_FROM_ADDRESS=your_email@example.com
EMAIL_REPLY_TO=support@example.com
PAYMENT_SUPPORT_EMAIL=support@example.com
EMAIL_PAYMENT_PENDING_ENABLED=true
EMAIL_PAYMENT_SUCCESS_ENABLED=true
EMAIL_PAYMENT_FAILED_ENABLED=true
EMAIL_SEND_TIMEOUT_MS=10000

# WhatsApp AI Agent internal services
INTERNAL_API_KEY=replace_with_internal_key
AGENT_SERVER_URL=http://localhost:8001
AGENT_REQUEST_TIMEOUT_MS=65000
WHATSAPP_CLIENT_ID=raahi-hackathon-chatbot
WHATSAPP_NOTIFICATION_API_KEY=replace_with_notification_key
AGENT_ERP_DATABASE_URL=postgresql+psycopg2://raahi_user:raahi_secret@localhost:5432/raahi
CHATBOT_DATABASE_URL=sqlite:///./data/chatbot.sqlite3
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
